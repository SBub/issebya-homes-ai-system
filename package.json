    "test": "turbo run test",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5"
  }
}
