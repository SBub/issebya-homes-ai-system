trees/
# `.claude/` above only matches a directory; inside a worktree .claude is a
# SYMLINK, which that rule does not match. This one catches both.
.claude
# written into each worktree by worktree_ops.setup_worktree_environment()
.ports.env
# scratch output (snapshots, traces) written by the Playwright MCP server into
# whatever directory it is launched from — see .mcp.json
.playwright-mcp/
# generated by Next on every `dev` and `build`, and it says so in its own header.
# The import inside flips between ./.next/dev/types/routes.d.ts (dev) and
# ./.next/types/routes.d.ts (build), so tracking it turns every build into a diff.
# One pattern, unanchored, so it covers all three Next apps.
next-env.d.ts
