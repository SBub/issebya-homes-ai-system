%% LEGEND
%% Light green fill + green border = built and live
%% Grey fill / dashed border = not yet built (flip to green as each piece is wired)
%% Red border = human-performed work, not delegated to any agent (permanent, not a build-status)
%% Pink fill = Telegram Gateway, human-in-the-loop checkpoint
%%
%% STRUCTURAL GAPS (design-sufficiency review, assuming everything below is fully built as scoped):
%% 1. No net-new demand engine — Ads/PR are unscoped stubs; Campaign Agent is scoped to existing guests only. Nothing targets people who don't know the property yet.
%% 2. Content supply capped by one human — Social Media Agent collects/captions b-roll but doesn't create it; filming stays 100% manual (HUMAN_CONTENT).
%% 3. OTA channels entirely outside the system — Airbnb/Booking.com replies + listing/rate management are HumanWork, untouched by any agent.
%% 4. No feedback loop to learn what fills rooms — CRM's "measures instrument effectiveness" is needs-design; Orchestrator can react to Availability/Finance but can't tell which campaigns convert.
%% 5. No pricing/yield lever — nothing adjusts price or pushes discounts on low-occupancy dates; Finance Tool is compliance-oriented (tax/invoices), not revenue management.
flowchart TB
 subgraph Tools["Tools"]
        AVAIL["Availability Tool<br><i>(GET issebya.com/api/availability?room=room1|room2)</i>"]
        FIN["Finance Tool"]
        CRM["CRM Tool<br><i>guest info + communication history; measures instrument effectiveness (needs design)</i>"]
  end
 subgraph Agents["Agents"]
        GCA["Guest-Comms Agent<br><i>(runs via WhatsApp; webpage contact, convo, posts campaigns/updates)</i>"]
        CAMP["Campaign Agent<br><i>(promotes right product to the right audience: product launch, brand awareness, promotional or seasonal, social media, email marketing)</i>"]
        SOC["Social Media Agent<br><i>(captions + alt text only; collect pool of ready b-roll to use)</i>"]
        ADS["Ads Agent<br><i>(stub, empty)</i>"]
        PR["PR Agent<br><i>(stub, empty)</i>"]
        DESIGN["Designer Agent<br><i>owns design system; creates digital + print assets</i>"]
  end
 subgraph Shared["Shared Teams"]
        SWE["Software Engineering Team<br><i>(webpage updates, custom solutions; shared across projects)</i>"]
  end
 subgraph HumanWork["Human Work (not yet delegated)"]
        HUMAN_CONTENT["Create Content<br><i>filming/making videos</i>"]
        HUMAN_LAUNDRY["Laundry"]
        HUMAN_CHECKIN["Guest Check-ins"]
        HUMAN_PLATFORM_REPLY["Answering Guests on Booking Platforms"]
        HUMAN_PLATFORM_MGMT["Managing Booking Platforms"]
  end
 subgraph FinanceCron["Finance System"]
        UPLOAD["Upload Page (apps/finance /upload)<br><i>human uploads Airbnb + Booking.com CSVs</i>"]
        CRON_M30["Modelo30 Ready<br><i>event-driven — triggered right after upload, not a separate schedule; sends Modelo30 report</i>"]
        CRON_INV["File Invoices<br><i>event-driven — triggered right after upload; guest name + amount paid per reservation, as a CSV attachment</i>"]
        CRON_TAX["Tourist Tax<br><i>event-driven — triggered when the uploaded month closes a quarter; CSV attachment</i>"]
        CRON_RFI["Cron: Annual (January)<br><i>RFI-21 re-issued by Airbnb; download, fill Section VI, resubmit. Booking.com equivalent: unknown. Out of scope for v0.1.0.</i>"]
        CRON_AIRBNB_PRICING["One-time: Oct 13 2026<br><i>Airbnb retires split-fee pricing for EU hosts — Modelo30/invoice fee formulas need updating (see docs/finance/modelo-30-filing.md, invoices-filing.md). Out of scope for v0.1.0.</i>"]
        FIN_GAPS["Not yet: IRS report (year-end)<br>expense tracking<br>P&amp;L<br>income forecast"]
  end
 subgraph NotificationCenter["Notification Center"]
        NOTIF["Notification Center<br><i>(needs design, out of scope for v0.1.0)<br>dispatches reminders; re-notifies until marked done</i>"]
  end
 subgraph PropertyCron["Property Mgmt System"]
        CRON_PROJ["Cron: 7 Days Before Month-End<br><i>send cleaning lady projected cleaning dates</i>"]
        CRON_CONFIRM["Cron: 48h Before Checkout<br><i>draft checkout confirmation for cleaning lady</i>"]
        PMA["Webhook listener<br><i>not an LLM agent — receives cleaning lady messages via webhook, drafts a reply, sends to Telegram Gateway. Standalone, not delegated by Orch-A.</i>"]
  end
 subgraph SystemHealth["System Health"]
        HEALTH["System Health Monitor<br><i>(needs design)<br>checks agents/tools/crons are up and running</i>"]
  end
 subgraph SocialMediaSystem["Social Media System"]
        SOC_GEN["Social Media Post Generator<br><i>single LLM call, not an autonomous agent — receives a post idea via Telegram, generates alt text (~100 SEO/AEO keywords) + a caption that continues the post's idea and ends in 5 hashtags, writes the result to Notion, replies via Telegram. Standalone, not delegated by Orch-A (same shape as PMA).</i>"]
  end
    AVAIL -. informs .-> ORCH["Orchestrator (Orch-A)<br><i>analyze -&gt; decide -&gt; dispatch -&gt; report loop</i>"] & CRON_PROJ & CRON_CONFIRM
    FIN -. informs .-> ORCH
    ORCH -- delegates --> CAMP & SOC & ADS & PR & DESIGN & SWE
    DESIGN -- provides assets --> SOC & CAMP
    SWE -- updates --> SITE(["Website"])
    SWE -- reports completion --> TG
    CAMP -- hands off content --> GCA
    GCA -- posts/replies --> GUEST(["Guest / Webpage Visitor"])
    PMA -- messages --> CLEAN(["Cleaning Lady"])
    CLEAN -- webhook: incoming message --> PMA
    PMA -- drafts reply, sends --> TG
    UPLOAD -- once CSVs uploaded --> CRON_M30 & CRON_INV
    CRON_M30 -- delivers --> TG(["Telegram Gateway"])
    CRON_INV -- delivers document --> TG
    UPLOAD -. if uploaded month closes a quarter .-> CRON_TAX
    CRON_TAX -- delivers document --> TG
    CRON_RFI -- requests via --> NOTIF
    CRON_AIRBNB_PRICING -- requests via --> NOTIF
    NOTIF -- delivers/re-notifies --> TG
    FIN -.-> FIN_GAPS
    CRON_PROJ -- delivers --> TG
    CRON_CONFIRM -- delivers --> TG
    TG -- forwards --> CLEAN
    HUMAN_CONTENT -. raw material for .-> SOC
    PMA -. not yet delegated .-> HUMAN_LAUNDRY & HUMAN_CHECKIN & HUMAN_PLATFORM_MGMT
    GCA -. not yet delegated .-> HUMAN_PLATFORM_REPLY
    CRM -. informs .-> ORCH
    GCA -. logs communication .-> CRM
    HEALTH -. monitors .-> ORCH
    HEALTH -- alerts --> TG
    ORCH -- reports --> TG

    %% CAVEAT (not yet resolved): if SOC_GEN's inbound webhook shares the
    %% same bot/chat TG already uses for outbound reports, only one webhook
    %% URL can be registered per bot token — needs either a dedicated
    %% bot/chat for this flow or a dispatch layer in front. Flagging before
    %% implementation, same open-question shape as PMA's own webhook setup.
    TG -- incoming: post idea --> SOC_GEN
    SOC_GEN -- writes post --> NOTION_SOCIAL(["Notion: Social Media Posts"])
    SOC_GEN -- replies with generated content --> TG
    UPLOAD -- syncs to Notion --> NOTION_FINANCE(["Notion: Finance Bookings"])

