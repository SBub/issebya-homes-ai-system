%% LEGEND
%% Light green fill + green border = built and live
%% Grey fill / dashed border = not yet built (flip to green as each piece is wired)
%% Red border = human-performed work, not delegated to any agent (permanent, not a build-status)
%% Pink fill = Telegram Gateway, human-in-the-loop checkpoint
%%
%% STRUCTURAL GAPS (design-sufficiency review, assuming everything below is fully built as scoped):
%% 1. No net-new demand engine — Ads/PR are unscoped stubs; Campaign Agent is scoped to existing guests only. Nothing targets people who don't know the property yet.
%% 2. Content supply capped by one human — SOC_GEN only turns an already-written idea into alt text/caption, it never touches raw footage; filming stays 100% manual (HUMAN_CONTENT), now with no delegated consumer of it at all.
%% 3. OTA channels entirely outside the system — Airbnb/Booking.com replies + listing/rate management are HumanWork, untouched by any agent.
%% 4. Feedback loop to learn what fills rooms — now further addressed (2026-07-21): CRM tracks guest funnel_stage (new -> informed -> link_sent -> booked) and a promo_codes lifecycle (issued -> sent/rejected, plus expired/redeemed in schema), and Orch-A's digest now surfaces an aggregate view of that activity via CRM's new GET /api/campaigns/stats (issued/sent/rejected counts per campaign kind, PII-free). Still genuinely open: no real redemption/conversion-to-paid-booking tracking exists (nothing marks a promo code redeemed against an actual booking — redeemed is hardcoded to 0 in every response), so this feedback loop can tell you &quot;activity happened&quot; but still can't tell you &quot;did it fill a room.&quot;
%% 5. No pricing/yield lever — nothing adjusts price or pushes discounts on low-occupancy dates; Finance Tool is compliance-oriented (tax/invoices), not revenue management.
flowchart TB
 subgraph Tools["Tools"]
        AVAIL["Availability Tool (GET /api/availability)"]
        FIN["Finance Tool"]
        CRM["CRM (apps/crm, port 3006)"]
  end
 subgraph Agents["Agents"]
        CAMP["Campaign Agent"]
        ADS["Ads Agent (stub)"]
        PR["PR Agent (stub)"]
        DESIGN["Designer Agent"]
  end
 subgraph Shared["Shared Teams"]
        SWE["Software Engineering Team"]
  end
 subgraph HumanWork["Human Work (not yet delegated)"]
        HUMAN_CONTENT["Create Content"]
        HUMAN_LAUNDRY["Laundry"]
        HUMAN_CHECKIN["Guest Check-ins"]
        HUMAN_PLATFORM_REPLY["Answering Guests on Booking Platforms"]
        HUMAN_PLATFORM_MGMT["Managing Booking Platforms"]
  end
 subgraph FinanceCron["Finance System"]
        UPLOAD["Upload Page (apps/finance /upload)"]
        CRON_M30["Modelo30 Ready"]
        CRON_INV["File Invoices"]
        CRON_TAX["Tourist Tax"]
        FIN_GAPS["Not Yet Built (Finance Gaps)"]
  end
 subgraph NotificationCenter["Notification Center"]
        NOTIF["Notification Center (apps/notifications)"]
        CRON_RFI["Cron: Annual (January)"]
        CRON_AIRBNB_PRICING["One-time: Oct 13 2026"]
        CRON_EOM["Cron: 2nd of Every Month"]
  end
 subgraph PropertyCron["Property Mgmt System"]
        CRON_PROJ["Cron: 7 Days Before Month-End"]
        CRON_CONFIRM["Cron: 48h Before Checkout"]
        PMA["Webhook Listener"]
  end
 subgraph SystemHealth["System Health"]
        HEALTH["System Health Monitor"]
  end
 subgraph SocialMediaSystem["Social Media System"]
        SOC_GEN["Social Media Post Generator"]
  end
 subgraph TelegramRouterSystem["Telegram Router"]
        ROUTER["Telegram Router"]
  end
    AVAIL -. informs .-> ORCH["Orchestrator (Orch-A)"] & CRON_PROJ & CRON_CONFIRM
    FIN -. informs .-> ORCH
    ORCH -- delegates --> CAMP & ADS & PR & DESIGN & SWE
    DESIGN -- provides assets --> CAMP
    SWE -- updates --> SITE(["Website"])
    SWE -- reports completion --> TG
    CAMP -- hands off content --> GCA["Guest-Comms Agent"]
    GCA -- posts/replies --> GUEST(["Guest / Webpage Visitor"])
    PMA -- messages --> CLEAN(["Cleaning Lady"])
    CLEAN -- webhook: incoming message --> PMA
    PMA -- drafts reply, sends --> TG
    UPLOAD -- once CSVs uploaded --> CRON_M30 & CRON_INV
    CRON_M30 -- delivers --> TG(["Telegram Gateway"])
    CRON_INV -- delivers document --> TG
    UPLOAD -. if uploaded month closes a quarter .-> CRON_TAX
    CRON_TAX -- delivers document --> TG
    CRON_RFI -- seeded as reminder in --> NOTIF
    CRON_AIRBNB_PRICING -- seeded as reminder in --> NOTIF
    ROUTER -- "sends reminder, &quot;✅ Done&quot; button" --> TG
    FIN -.-> FIN_GAPS
    CRON_PROJ -- delivers --> TG
    CRON_CONFIRM -- delivers --> TG
    TG -- forwards --> CLEAN
    PMA -. not yet delegated .-> HUMAN_LAUNDRY & HUMAN_CHECKIN & HUMAN_PLATFORM_MGMT
    GCA -. not yet delegated .-> HUMAN_PLATFORM_REPLY
    CRM -. informs .-> ORCH
    GCA -. logs communication .-> CRM
    HEALTH -. checks .-> NOTIF & UPLOAD & SOC_GEN & ORCH
    HEALTH -- alerts --> TG
    ROUTER -- sends digest --> TG

    %% RESOLVED: the whole system migrated to one shared bot token that
    %% nothing else (e.g. Hermes) registers a webhook against, so ROUTER's
    %% inbound webhook — the only one in the whole system now that it owns
    %% all Telegram I/O — has that bot's webhook slot exclusively. Same TG
    %% bot as every other edge in this diagram. apps/orch-a had
    %% TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID removed from its own config
    %% entirely (it has zero Telegram awareness now); only
    %% apps/telegram-router still holds TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID
    %% directly now, as the sole sender for the whole system. Known,
    %% unaddressed fact: apps/finance still separately holds its own
    %% TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID and still sends Telegram messages
    %% directly, bypassing the router entirely — the same "odd one out"
    %% situation Orch-A used to be in.
    TG -- "/social &lt;idea&gt;" --> ROUTER
    TG -- "/cron list" --> ROUTER
    TG -- "/digest" --> ROUTER
    TG -- "/heartbeat" --> ROUTER
    ROUTER -- replies with generated content --> TG
    ROUTER -- sends cron jobs list --> TG
    ROUTER -- sends health summary --> TG
    CRON_EOM -- seeded as reminder in --> NOTIF
    SITE -- "WhatsApp link" --> GCA
    ROUTER -- calls /api/generate --> SOC_GEN
    TG -- "Done button press" --> ROUTER
    ROUTER -- calls /api/reminders/* --> NOTIF
    ROUTER -- calls /digest --> ORCH
    UPLOAD -- calls /api/guest-contacts/sync --> CRM
    GCA -- calls /api/guest-contacts/lookup --> CRM
    CRM -- calls /api/campaign-drafts --> ROUTER
    ROUTER -- "calls /api/promo-codes/* (check + mark-sent/rejected)" --> CRM
    ROUTER -- calls /api/send --> GCA
    CRM -. design intent, not built, notifies GCA to craft a personalized nudge per guest .-> GCA
    SOC_GEN -. design intent, schema only, social post or comment should trigger a code-word campaign .-> CRM

