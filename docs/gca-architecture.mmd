%% LEGEND
%% Light green fill + green border = built, live, and verified this session
%% Grey fill / dashed border = exists but not a closed loop (no automatic action taken)
%% Pink fill = Telegram, human-in-the-loop checkpoint
%% Dashed diamond = a model/prompt-level judgment call, not a deterministic code path
%%
%% Detail view of the GCA["Guest-Comms Agent"] node in docs/agent-architecture.mmd —
%% everything below sits inside that one green box in the system-level diagram.
%% Narrative history from this session's work (comment threads on
%% tools.ts/agent.ts/embed.ts/the escalation-nudges route/webhook).
%% As of 2026-08-03 this is a plain async tool-calling loop (src/agent/run-turn.ts's
%% runAgentTurn), not a LangGraph StateGraph — the node/edge machinery was replaced
%% because GCA is (and is staying) a single agent with no multi-agent routing/
%% supervision/fan-out, so it wasn't earning its keep. Same runtime behavior as before,
%% including the "every tool loops back for another model round" shape below.
%% Also as of 2026-08-03, the model round itself runs on Vercel AI SDK's generateText
%% (the "ai" package + @ai-sdk/openai, pointed at OpenRouter) instead of
%% @langchain/openai's ChatOpenAI — tools are now AI SDK tool() objects whose execute
%% functions AI SDK dispatches automatically (T_BOOK/T_ESC are built fresh per turn via
%% a closure-based factory carrying conversationId/phone/triggerMessageId, replacing
%% LangChain's RunnableConfig.configurable threading). One narrow LangChain usage
%% remains: @langchain/core/load + @langchain/core/prompts, only to deserialize the
%% LangSmith Prompt Hub commit pulled below into plain system-prompt text. Known gap
%% this migration did NOT fix: the AGENT -. "recorded via langsmith_run_id" .->
%% LANGSMITH_FB
%% edge below no longer corresponds to a real LangSmith run (AI SDK has no
%% LangChain-style automatic LangSmith tracing), so that edge is now aspirational, not
%% live — kept green below pending a product decision on how (or whether) to restore
%% real trace correlation, not because it's still actually true.
flowchart TB
    GUEST(["Guest / WhatsApp"])
    OWNER(["Owner"])

    subgraph Inbound["Inbound"]
        TWILIO_WEBHOOK["POST /api/webhook/whatsapp<br/>(validates X-Twilio-Signature,<br/>generates a runId, calls runAgentTurn)"]
    end

    subgraph AgentLoop["runAgentTurn: loadContext, then loop { model &lt;-&gt; tools } until a final reply"]
        LOAD["loadContext<br/>(loads whatsapp_conversations/messages<br/>+ guest info via CRM lookup)"]
        AGENT["model round<br/>(pulls system prompt from LangSmith<br/>Prompt Hub: whatsapp-booking-agent:production)"]
        T_PRICE["getPricing<br/>(hardcoded flat rate, not a real pricing source)"]
        T_AVAIL["checkAvailability<br/>(GET /api/availability)"]
        T_BOOK["sendBookingLink<br/>(writes booking_link_requests)"]
        T_KB["answerPropertyQuestion"]
        T_ESC["escalateToOwner"]
    end

    ESCALATE_DECISION{{"model decides whether to call<br/>escalateToOwner (prompt-level<br/>judgment, not a hard rule)"}}

    subgraph KB["Knowledge Base"]
        KB_FILES["apps/guest-communication-agent/<br/>knowledge-base/*.md (18 files)"]
        EMBED["yarn embed<br/>(diff-based upsert, keyed on<br/>source+section+content_hash —<br/>skips embedding/DB write entirely<br/>for unchanged chunks)"]
        DOCS[("documents<br/>pgvector table, 39 rows<br/>metadata = source/section/content_hash only")]
        MATCH["match_documents RPC<br/>(unfiltered similarity search —<br/>type-based filtering was tried,<br/>removed after real false negatives)"]
    end

    subgraph Escalation["performEscalation — unified across all three categories"]
        PERF_ESC["performEscalation<br/>(wants_human / complaint /<br/>missing_info)"]
        ESC_ROW[("escalations row<br/>+ telegram_message_id")]
        NUDGE["POST /api/escalation-nudges<br/>(apps/telegram-router)"]
    end

    subgraph MissingInfoLoop["missing_info only: reply-capture + resolve"]
        WEBHOOK["telegram-router webhook<br/>handleEscalationReply<br/>(correlates reply_to_message.message_id<br/>-&gt; escalations.telegram_message_id)"]
        CATEGORY_GUARD{"reason_category ==<br/>missing_info ?"}
        RELAY["sendGuestMessage<br/>(POST /api/send)"]
        RESOLVE["POST /api/escalations/:id/resolve<br/>(embeds answer, inserts into documents,<br/>sets resolved_at)"]
        ACK["plain acknowledgment —<br/>no guest-send, no KB write,<br/>no automatic resolution yet"]
    end

    subgraph Eval["Eval feedback (owner-reviewed, from the CRM dashboard)"]
        CRM_FEEDBACK["POST /api/messages/:id/feedback"]
        LANGSMITH_FB["LangSmith createFeedback<br/>(human_approval: score + comment)"]
    end

    GUEST -- "WhatsApp message" --> TWILIO_WEBHOOK
    TWILIO_WEBHOOK -- "invoke(runId)" --> LOAD
    LOAD --> AGENT
    AGENT -- "tool call" --> T_PRICE & T_AVAIL & T_BOOK & T_KB & T_ESC
    T_PRICE --> AGENT
    T_AVAIL --> AGENT
    T_BOOK --> AGENT
    T_KB --> AGENT
    T_ESC --> AGENT
    AGENT -- "reply (this turn's own trace)" --> GUEST
    AGENT -. "recorded via langsmith_run_id" .-> LANGSMITH_FB

    T_KB --> MATCH
    MATCH --> DOCS
    KB_FILES --> EMBED
    EMBED --> DOCS

    AGENT -. considers .-> ESCALATE_DECISION
    ESCALATE_DECISION -. "no (declines gracefully, no escalation at all)" .-> GUEST
    ESCALATE_DECISION -- "yes" --> T_ESC

    T_ESC --> PERF_ESC
    PERF_ESC --> ESC_ROW
    PERF_ESC --> NUDGE
    NUDGE -- "Telegram message" --> OWNER

    OWNER -- "replies with free text" --> WEBHOOK
    WEBHOOK --> CATEGORY_GUARD
    CATEGORY_GUARD -- "yes" --> RELAY
    CATEGORY_GUARD -- "no" --> ACK
    RELAY -- "WhatsApp" --> GUEST
    RELAY --> RESOLVE
    RESOLVE --> DOCS

    CRM_FEEDBACK --> LANGSMITH_FB

