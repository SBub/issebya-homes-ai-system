# Same bot/chat every app in this repo uses.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# incoming webhook request. Generate: openssl rand -hex 32
# Must match the `secret_token` passed to Telegram's setWebhook call when
# registering this endpoint's public URL.
TELEGRAM_WEBHOOK_SECRET=

# Where apps/social-media's plain logic API is reachable (no trailing slash).
SOCIAL_MEDIA_API_URL=http://localhost:3002

# Shared secret with apps/social-media's own SOCIAL_MEDIA_API_KEY — sent as
# the X-API-Key header on calls to its /api/generate route, so that endpoint
# can't be hit by anything except this router. Generate: openssl rand -hex 32
SOCIAL_MEDIA_API_KEY=

# Where apps/notifications' plain logic API is reachable (no trailing slash).
NOTIFICATIONS_API_URL=http://localhost:3004

# Shared secret with apps/notifications' own NOTIFICATIONS_API_KEY — same
# pattern as SOCIAL_MEDIA_API_KEY above. Generate: openssl rand -hex 32
NOTIFICATIONS_API_KEY=

# Where apps/orch-a's Mastra server is reachable (no trailing slash) — its
# digest lives at GET /digest, not under Mastra's own /api prefix (see
# apps/orch-a/src/mastra/routes/digest.ts). Default `mastra dev`/`mastra
# start` port is 4111.
ORCH_A_API_URL=http://localhost:4111

# Shared secret with apps/orch-a's own ORCH_A_API_KEY — same pattern as
# SOCIAL_MEDIA_API_KEY above. Generate: openssl rand -hex 32
ORCH_A_API_KEY=

# Checked via X-Cron-Secret on POST /api/cron/check-reminders and
# POST /api/cron/check-digest — protects them from anything except whatever
# real scheduler ends up calling them (still open, same deployment/hosting
# question as the rest of this repo). Generate: openssl rand -hex 32
CRON_SECRET=

# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo already uses. Used only for
# telegram_delivery_failures, the shared durable fallback for Telegram sends
# that fail even after a retry (see src/lib/telegram/delivery-failures.ts).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
