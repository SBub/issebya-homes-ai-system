# Same bot/chat every app in this repo uses.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# incoming webhook request. Generate: openssl rand -hex 32
# Must match the `secret_token` passed to Telegram's setWebhook call when
# registering this endpoint's public URL.
TELEGRAM_WEBHOOK_SECRET=

# Checked via X-API-Key (app/auth.py's require_api_key) on
# POST /api/owner-nudges — this app's inbound API-key-guarded route (it's
# only ever been a caller of other apps' before). Caller:
# apps/guest-communication-agent's own requestOwnerNudge (see
# @/agent/tools/owner-nudge.ts). Mirror this same value into that app's own
# TELEGRAM_ROUTER_API_KEY. Generate: openssl rand -hex 32
TELEGRAM_ROUTER_API_KEY=

# Where apps/guest-communication-agent's plain logic API is reachable (no
# trailing slash). app/gca.py calls three of its routes:
# POST /api/send (actual guest-facing WhatsApp delivery, sendGuestMessage —
# currently unused by this app's own webhook route, still exported/tested
# for gca.py's own API surface), POST
# /api/owner-nudges/:correlationId/answer (answerOwnerNudge — the
# missing_info owner-reply flow, see routers/telegram_webhook.py's
# handle_owner_nudge_reply), and POST /api/owner-nudges/:correlationId/approve
# (answerBookingLinkApproval — the send_booking_link approve/reject flow,
# see routers/telegram_webhook.py's handle_callback_query).
GUEST_COMMUNICATION_AGENT_API_URL=http://localhost:3005

# Shared secret with apps/guest-communication-agent's own
# GUEST_COMMUNICATION_AGENT_API_KEY. Generate: openssl rand -hex 32
GUEST_COMMUNICATION_AGENT_API_KEY=

# Axiom — OTel tracing for this router's own webhook/relay/Telegram-API spans
# (see app/main.py's lifespan, app/tracing.py). Same contract as
# guest-communication-agent's own AXIOM_TOKEN/AXIOM_DATASET/AXIOM_DOMAIN:
# best-effort, unset just skips the processor.
#
# The dataset only ever sees request-driven traffic — there is no heartbeat
# task emitting spans on a timer any more (it could not fire reliably on a
# request-driven Vercel Function). Liveness is an external uptime ping
# against GET /api/health instead.
#
# AXIOM_DATASET must be exactly "telegram-router" — the GCA-app-health
# dashboard's Telegram-routes panels query that literal dataset name (via
# APL `union` alongside guest-communication-agent's own dataset). A
# different value means those panels see no data.
AXIOM_TOKEN=
AXIOM_DATASET=telegram-router
AXIOM_DOMAIN=

# Sentry — error tracking (see app/main.py's lifespan Sentry block).
# Best-effort like AXIOM_TOKEN/AXIOM_DATASET above: unset SENTRY_DSN just
# skips it, nothing else degrades. Deliberately kept separate from the Axiom
# SpanProcessor above — sentry_sdk.init() creates its own error-tracking
# client only, it does not add another SpanProcessor to the shared OTel
# provider, so this doesn't affect what Axiom sees.
#
# This app needs its OWN Sentry project — same one-project-per-app
# convention as AXIOM_DATASET's one-dataset-per-app above, so this router's
# errors don't mix into guest-communication-agent's Sentry project. A
# telegram-router-specific Sentry project doesn't exist yet — create one in
# Sentry's UI (issebya org, EU/DE-data-plane, same region convention as
# Axiom's eu-central-1.aws.edge.axiom.co above) and paste its DSN here, from
# that project's Settings > Client Keys (DSN).
SENTRY_DSN=

# Set to "1" locally to print every span to stdout as it ends — see
# app/main.py's lifespan. Never set in a real deployment: spans here carry
# reply text.
DEBUG_TRACING=

# Gates the production-only checks in app/main.py's lifespan (Axiom required,
# Sentry enabled) — Python has no NODE_ENV equivalent, so this app defines its
# own. Must be exactly "production"; unset/anything else is treated as dev.
# The Vercel project must set ENVIRONMENT=production explicitly — nothing
# sets it for you there, and without it a production deployment boots with
# the dev policy (Axiom optional, Sentry off).
ENVIRONMENT=
