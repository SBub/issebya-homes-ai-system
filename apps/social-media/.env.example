# Same bot/chat apps/orch-a and apps/finance already use, configured
# independently per app (same duplication pattern as DATABASE_URL elsewhere).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# incoming webhook request, so this endpoint can't be triggered by an
# arbitrary POST from the internet. Generate: openssl rand -hex 32
# Must match the `secret_token` passed to Telegram's setWebhook call when
# registering this endpoint's public URL (still open — see
# docs/monorepo-migration-plan.md-style deployment/hosting question).
TELEGRAM_WEBHOOK_SECRET=

# Same OpenRouter key apps/orch-a uses.
OPENROUTER_API_KEY=

# Same Notion integration key apps/finance uses. Target database is
# "Social Media Posts", a real database (not just a page) shared with that
# integration: "Name" (title), "Alt text" (rich_text), "Caption" (rich_text)
# — see src/lib/social/notion.ts. Import still works with these unset —
# sync is just skipped.
NOTION_API_KEY=
NOTION_DATABASE_ID=
