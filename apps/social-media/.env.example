# Same bot/chat apps/orch-a and apps/finance already use, configured
# independently per app (same duplication pattern as DATABASE_URL elsewhere).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# incoming webhook request, so this endpoint can't be triggered by an
# arbitrary POST from the internet. Generate: openssl rand -hex 32
# Must match the `secret_token` passed to Telegram's setWebhook call when
# registering this endpoint's public URL (still open — see
# docs/monorepo-migration-plan.md-style deployment/hosting question).
TELEGRAM_WEBHOOK_SECRET=

# Same OpenRouter key apps/orch-a uses.
OPENROUTER_API_KEY=

# NOTE: unlike apps/finance, this database does NOT exist yet as a real
# Notion database/table — the page shared for this
# (Social-media-posts-3a2293bf035480eca81be3df637ac643) needs to actually be
# turned into a database (table view), have its columns added (currently
# assumed: "Post idea" title, "Alt text" rich_text, "Caption" rich_text,
# "Created" date — confirm/adjust against the real table in
# src/lib/social/notion.ts), and be shared with the Notion integration via
# its "•••" menu -> Connections, same as apps/finance's test database was.
# Import still works with these unset — sync is just skipped.
NOTION_API_KEY=
NOTION_DATABASE_ID=
