# Twilio's WhatsApp webhook auth: this app validates X-Twilio-Signature
# using this token (see src/lib/twilio.ts). Account-wide (Twilio console >
# Account Info), the same value in every environment: the Sandbox and the
# real WhatsApp Business sender live under the same Twilio account.
TWILIO_AUTH_TOKEN=

# Required for OUTBOUND sends (src/lib/twilio-send.ts's sendWhatsAppMessage,
# used by run-guest-turn.ts's reply delivery). Twilio's REST API
# authenticates outbound calls with Account SID + Auth Token together,
# unlike inbound signature verification above which only needs the Auth
# Token. Account-wide like TWILIO_AUTH_TOKEN, same value in every env.
TWILIO_ACCOUNT_SID=

# The exact public URL Twilio POSTs to and signs against. Must match what
# Twilio has registered byte for byte (scheme, host, path, query string) or
# signature verification fails. Per environment:
#   dev:  https://<reserved ngrok domain>/api/webhook/whatsapp, fronted by the
#         webhook gateway on :3010 (docs/ngrok-webhook-gateway-sop.md).
#   prod: https://issebya-homes-ai-system-guest-commu.vercel.app/api/webhook/whatsapp
#         (the Vercel production domain, registered on the Twilio Messaging
#         Service; see docs/twilio-whatsapp-sender-sop.md).
TWILIO_WEBHOOK_URL=

# The `From` address for outbound sends (src/lib/twilio-send.ts). Per
# environment (docs/twilio-whatsapp-sender-sop.md):
#   dev:  whatsapp:+14155238886, Twilio's shared WhatsApp Sandbox number (not
#         a secret; only reaches phones that have sent the Sandbox join code).
#   prod: whatsapp:+351968011894, the real WhatsApp Business sender (Meta
#         WABA, attached to the Twilio Messaging Service "issebya.homes").
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo uses, but accessed here via Supabase's REST
# client (@supabase/supabase-js), not raw pg.Pool like every other app —
# ported as-is from the source app, which used Supabase-JS throughout
# (ORM-style .from()/.rpc() calls, not raw SQL). `supabase status` prints
# the Project URL/keys to use here (Publishable -> SUPABASE_ANON_KEY,
# Secret -> SUPABASE_SERVICE_ROLE_KEY, on newer Supabase CLI versions).
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — used both for the agent's model (deepseek/deepseek-v4-pro,
# via @langchain/openai's ChatOpenAI pointed at OpenRouter's base URL) and
# for property-question.ts's embedding calls. Same key apps/social-media uses.
OPENROUTER_API_KEY=

# Braintrust: required for the agent to produce any reply at all. None of
# the three prompts is a file in this repo; each is loaded live from
# Braintrust by slug via loadPrompt(), with no pinned version, so the
# slug's latest saved version is what runs on the very next turn:
#   gca-system                  src/agent/run-agent-turn.ts (also evals/executors.ts)
#   conversation-summarizer     src/agent/memory.ts
#   guest-preferences-distiller src/agent/memory.ts
# Prompts are managed in Braintrust itself: edit and save in the Prompts UI,
# or PUT via the prompt API by slug. There is no migration/push script in
# this repo. To roll back, open the prompt's version history in Braintrust
# and restore the earlier version (that makes it "latest" again); there is
# no env var that pins a version.
# issebya's org is EU-data-plane: api.braintrust.dev's default (US) data
# plane 421s with a DataPlaneRedirectError; PUT/GET calls should target
# api-eu.braintrust.dev instead. BRAINTRUST_PROJECT_ID: find it in
# Braintrust's UI under this project's Settings (or via `bt` CLI / API).
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=

# Optional. BRAINTRUST_API_URL overrides the EU-data-plane default that
# src/lib/tracing.ts bakes in (https://api-eu.braintrust.dev); only needed
# outside issebya's org. Leave unset here.
BRAINTRUST_API_URL=

# Braintrust environment labelling, read by the braintrust SDK itself (not
# by this app's code). Unset locally: the SDK auto-detects development/local.
# On Vercel it would auto-label the environment as "vercel", which the
# "production" filter in Braintrust's UI does not match, so Vercel Production
# sets these two explicitly to production / server. Leave unset in dev.
BRAINTRUST_ENVIRONMENT_NAME=
BRAINTRUST_ENVIRONMENT_TYPE=

# Axiom — general app-health OTel (HTTP/API-route/fetch/DB spans, everything
# Braintrust's BraintrustSpanProcessor filters out via filterAISpans). Separate
# concern from Braintrust above: same underlying OTel provider/span stream, just
# a second unfiltered SpanProcessor (see src/instrumentation.ts), so the AI spans
# Braintrust already gets show up here too, alongside webhook/DB/reply-delivery
# spans it never got. Best-effort like Braintrust: unset means this processor is
# skipped, Braintrust-only tracing keeps working.
# AXIOM_DOMAIN defaults to api.axiom.co if unset. Axiom span attributes carry the
# same raw guest message content/phone numbers Braintrust spans already do — if
# data residency matters here the way it did for BRAINTRUST_API_KEY above (EU),
# pick an EU edge domain from the Axiom account's settings instead of the default.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_DOMAIN=

# Sentry — error tracking (see src/instrumentation.ts's Sentry block).
# Best-effort like Braintrust/Axiom above: unset SENTRY_DSN just skips it,
# nothing else degrades. On top of that, Sentry.init() only ever runs when
# NODE_ENV=="production" regardless of SENTRY_DSN — dev/local/test never
# talk to the real Sentry project, by design (see the NODE_ENV check in
# src/instrumentation.ts). Deliberately kept separate from the Braintrust/
# Axiom SpanProcessors above — Sentry.init() creates its own error-tracking
# client only (skipOpenTelemetrySetup: true), it does not add another
# SpanProcessor to the shared OTel provider, so this doesn't affect what
# Axiom/Braintrust see. issebya's Sentry org ("issebya") is EU/DE-data-plane
# — same region convention as Braintrust (api-eu.braintrust.dev) and Axiom
# (eu-central-1.aws.edge.axiom.co) above; get the DSN from Sentry's UI under
# this project's Settings > Client Keys (DSN).
# SENTRY_AUTH_TOKEN is build-time only (source-map upload via
# withSentryConfig() in next.config.ts) — generate one under Sentry's UI >
# Settings > Auth Tokens. Unset/blank just skips the source-map upload
# (build/typecheck/dev all still work) — see next.config.ts's comment.
# SENTRY_ORG/SENTRY_PROJECT are this app's Sentry org/project slugs, also
# only used for that same source-map upload step — @sentry/nextjs's
# withSentryConfig() reads these two env vars itself (not hardcoded in
# next.config.ts, so they need to be set here instead). Find them in
# Sentry's UI under this project's Settings > General Settings.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set to "1" locally to print every span to stdout as it ends (see
# src/instrumentation.ts) — no Axiom/Braintrust account needed, just `yarn dev`
# and watch the terminal. Independent of/additive to Axiom and Braintrust
# above. NEVER set this in a real deployment — it console-logs full span
# attributes, including guest message content.
DEBUG_TRACING=

# Where GET /api/availability?room= is reachable (checkAvailability/
# sendBookingLink tools call it directly, same as the source app). Falls
# back to production (https://issebya.com) if unset — be deliberate about
# what this points at in dev.
NEXT_PUBLIC_SITE_URL=

# Where apps/telegram-router's plain logic API is reachable (no trailing
# slash). All three escalation categories (escalateToOwner tool, agent.ts's
# step-cap/empty-reply safety nets) route their owner notification through
# it — see src/lib/telegram-router.ts's sendEscalationNudge (called from
# src/graph/tools.ts's performEscalation) and its own
# POST /api/escalation-nudges. This app no longer talks to Telegram directly
# at all (there used to be a TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID raw-fetch
# bypass here for the two non-missing_info categories — removed; see
# git history for src/lib/telegram.ts) — telegram-router is now the sole
# Telegram channel for this app, matching every other app in this repo.
# Best-effort like apps/crm's postCampaignDraft: unset means the escalation
# row still gets created, the owner just never gets nudged.
# In production this MUST be an https:// URL (the telegram-router Vercel
# domain). An http:// value gets a 308 redirect from Vercel, and the
# X-API-Key header travels in cleartext on that first hop before the
# redirect. Plain http://localhost is fine for local dev only.
TELEGRAM_ROUTER_API_URL=http://localhost:3003

# Shared secret with apps/telegram-router's own TELEGRAM_ROUTER_API_KEY —
# same pattern as GUEST_COMMUNICATION_AGENT_API_KEY below. Generate:
# openssl rand -hex 32
TELEGRAM_ROUTER_API_KEY=

# Approved WhatsApp Content-API template SIDs, one per campaign kind (see
# docs/whatsapp-campaign-templates.md for why a template is required at
# all). Neither template has been created or approved yet. The WABA exists
# now (docs/twilio-whatsapp-sender-sop.md); leave both unset until
# docs/whatsapp-campaign-templates.md's two drafted templates have been
# submitted to and approved by Meta. Not
# read by any live send path yet — the code that would have sent them
# (sendWhatsAppTemplate/getTemplateSidForCampaignKind in
# src/lib/twilio-send.ts, and the proactive-send endpoint POST /api/send
# that would have called them) was removed as dead code ahead of this
# feature being wired up; campaign nudges are not supported by this app.
TEMPLATE_SID_RETURNING_GUEST_DISCOUNT=
TEMPLATE_SID_WINTER_LOCKIN_PROGRAM=

# Guards this app's API-key-protected routes (src/lib/auth.ts's
# requireApiKey) — POST /api/escalations/[id]/answer and
# GET /api/escalations/by-telegram-message-id/[telegramMessageId]. The
# other route, POST /api/webhook/whatsapp, is guarded by Twilio's own
# request signature instead, not an API key. Mirror this same value into
# any caller's .env too (apps/telegram-router).
GUEST_COMMUNICATION_AGENT_API_KEY=
