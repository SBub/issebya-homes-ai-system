# Twilio's WhatsApp webhook auth — this app validates X-Twilio-Signature
# using this token (see src/lib/twilio.ts). From the Twilio console once a
# real account/WhatsApp sender exists.
TWILIO_AUTH_TOKEN=

# Required for OUTBOUND sends (src/lib/twilio-send.ts's sendWhatsAppMessage,
# used by POST /api/send) — Twilio's REST API authenticates outbound calls
# with Account SID + Auth Token together, unlike inbound signature
# verification above which only needs the Auth Token.
TWILIO_ACCOUNT_SID=

# The exact public URL Twilio POSTs to and signs against (must match exactly
# — scheme, host, path, query string — or signature verification fails).
# No permanent public URL yet (same open deployment/hosting question as the
# rest of this repo) — placeholder for local/tunnel testing until then.
TWILIO_WEBHOOK_URL=http://localhost:3005/api/webhook/whatsapp

# The `From` address for outbound sends (src/lib/twilio-send.ts). Twilio's
# Sandbox always sends from whatsapp:+14155238886 — that literal value (not
# a secret) is the right default until a real WhatsApp Business sender is
# provisioned.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo uses, but accessed here via Supabase's REST
# client (@supabase/supabase-js), not raw pg.Pool like every other app —
# ported as-is from the source app, which used Supabase-JS throughout
# (ORM-style .from()/.rpc() calls, not raw SQL). `supabase status` prints
# the Project URL/keys to use here (Publishable -> SUPABASE_ANON_KEY,
# Secret -> SUPABASE_SERVICE_ROLE_KEY, on newer Supabase CLI versions).
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — used both for the agent's model (deepseek/deepseek-v4-pro,
# via @langchain/openai's ChatOpenAI pointed at OpenRouter's base URL) and
# for search-property.ts's embedding calls. Same key apps/orch-a/
# apps/social-media use.
OPENROUTER_API_KEY=

# LangSmith — required for the agent to produce any reply at all. The
# system prompt is NOT a file in this repo; agent.ts pulls it live from
# LangSmith's Prompt Hub (whatsapp-booking-agent:production) every turn.
# Needs access to the same LangSmith org/prompt as issebya-homes-website's
# apps/guest-communication-agent. EU region — LANGSMITH_ENDPOINT matters:
# omitting it silently routes to the US default and every call fails auth
# in a way that doesn't obviously point at "wrong region."
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=issebya-whatsapp-agent

# Where GET /api/availability?room= is reachable (checkAvailability/
# sendBookingLink tools call it directly, same as the source app). Falls
# back to production (https://issebya.com) if unset — be deliberate about
# what this points at in dev.
NEXT_PUBLIC_SITE_URL=

# Where apps/telegram-router's plain logic API is reachable (no trailing
# slash). All three escalation categories (escalateToOwner tool, agent.ts's
# step-cap/empty-reply safety nets) route their owner notification through
# it — see src/lib/telegram-router.ts's sendEscalationNudge (called from
# src/graph/tools.ts's performEscalation) and its own
# POST /api/escalation-nudges. This app no longer talks to Telegram directly
# at all (there used to be a TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID raw-fetch
# bypass here for the two non-missing_info categories — removed; see
# git history for src/lib/telegram.ts) — telegram-router is now the sole
# Telegram channel for this app, matching every other app in this repo.
# Best-effort like apps/crm's postCampaignDraft: unset means the escalation
# row still gets created, the owner just never gets nudged.
TELEGRAM_ROUTER_API_URL=http://localhost:3003

# Shared secret with apps/telegram-router's own TELEGRAM_ROUTER_API_KEY —
# same pattern as GUEST_COMMUNICATION_AGENT_API_KEY below. Generate:
# openssl rand -hex 32
TELEGRAM_ROUTER_API_KEY=

# Approved WhatsApp Content-API template SIDs, one per campaign kind (see
# src/lib/twilio-send.ts's CAMPAIGN_KIND_TEMPLATE_ENV_VAR and
# getTemplateSidForCampaignKind, and docs/whatsapp-campaign-templates.md for
# why a template is required at all). Neither template has been created or
# approved yet — leave both unset until a real WABA exists and
# docs/whatsapp-campaign-templates.md's two drafted templates have been
# submitted to and approved by Meta. Not read by any live send path yet;
# sendWhatsAppTemplate/getTemplateSidForCampaignKind are prepared but not
# wired into POST /api/send or the Telegram-approval webhook.
TEMPLATE_SID_RETURNING_GUEST_DISCOUNT=
TEMPLATE_SID_WINTER_LOCKIN_PROGRAM=

# CRM (apps/crm, port 3006) — owns guest_contacts. src/lib/crm.ts's
# lookupGuestContact() calls CRM's GET /api/guest-contacts/lookup with this
# key on every conversational turn (see load_context) — deliberately
# resilient to CRM being unreachable (returns null, doesn't throw; see
# crm.ts's own doc comment). Same value as CRM's own CRM_API_KEY.
CRM_API_URL=http://localhost:3006
CRM_API_KEY=

# Guards the new POST /api/send (src/lib/auth.ts's requireApiKey) — this
# app's only other route, POST /api/webhook/whatsapp, is guarded by
# Twilio's own request signature instead, not an API key. Mirror this same
# value into any caller's .env too (a later phase's Telegram
# approve/reject flow, in apps/telegram-router).
GUEST_COMMUNICATION_AGENT_API_KEY=
