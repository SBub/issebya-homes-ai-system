# Twilio's WhatsApp webhook auth — this app validates X-Twilio-Signature
# using this token (see src/lib/gca/twilio.ts). From the Twilio console once
# a real account/WhatsApp sender exists; no real Twilio account is
# configured yet, this is still a scaffold (see the webhook route's own doc
# comment for what's deferred).
TWILIO_AUTH_TOKEN=

# The exact public URL Twilio POSTs to and signs against (must match exactly
# — scheme, host, path, query string — or signature verification fails).
# No permanent public URL yet (same open deployment/hosting question as the
# rest of this repo) — placeholder for local/tunnel testing until then.
TWILIO_WEBHOOK_URL=http://localhost:3005/api/webhook/whatsapp
