{
  "name": "guest-communication-agent",
  "version": "0.1.0",
  "description": "Guest-Comms Agent (GCA) — WhatsApp guest communication. Twilio webhook (POST /api/webhook/whatsapp) runs a plain async tool-calling agent loop (src/agent/) — the same reasoning/tools as issebya-homes-website's apps/guest-communication-agent, faithfully ported, not redesigned.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env.development scripts/dev.ts",
    "build": "next build",
    "start": "next start --port 3005",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed": "tsx --env-file=.env scripts/embed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@braintrust/otel": "^0.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nextjs": "^10",
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/sandbox": "^3.0.0",
    "ai": "^6.0.138",
    "braintrust": "^3.27.0",
    "gpt-tokenizer": "^4.0.0",
    "inngest": "^4.15.0",
    "next": "^16.2.1",
    "pricing": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "inngest-cli": "^1.41.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
