# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo already uses.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Checked via X-API-Key on every /api/reminders/* route (and /api/health) —
# only apps/telegram-router calls this app, using the same value in its own
# .env. Generate: openssl rand -hex 32
NOTIFICATIONS_API_KEY=
