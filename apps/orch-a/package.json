{
  "name": "orch-a",
  "version": "0.1.0",
  "description": "Orch-A — orchestrator agent for the issebya.homes automation system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/start.ts",
    "build": "mastra build",
    "start": "mastra start",
    "run:heartbeat": "tsx --env-file=.env src/run.ts",
    "preview:digest": "tsx scripts/preview-digest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "^1.51.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "mastra": "^1.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
