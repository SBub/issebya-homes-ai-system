# From `supabase start` (local Supabase CLI dev stack) — see README
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Checked via X-API-Key on GET /digest and GET /health — only
# apps/telegram-router calls this app, using the same value in its own .env
# (ORCH_A_API_KEY there too). Generate: openssl rand -hex 32
ORCH_A_API_KEY=

OPENROUTER_API_KEY=

# apps/crm (port 3006) — GET /api/campaigns/stats, for the digest's
# Campaigns section (aggregate promo-code counts per kind, no PII). Same
# value as CRM's own CRM_API_KEY, same pattern every other CRM-calling app
# in this repo already uses (see apps/finance/.env.example).
CRM_API_URL=
CRM_API_KEY=
