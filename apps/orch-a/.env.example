# From `supabase start` (local Supabase CLI dev stack) — see README
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Checked via X-API-Key on GET /digest — only apps/telegram-router calls this
# app, using the same value in its own .env (ORCH_A_API_KEY there too).
# Generate: openssl rand -hex 32
ORCH_A_API_KEY=

OPENROUTER_API_KEY=
