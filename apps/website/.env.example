# Environment configuration template
# Copy to .env.development (for local dev) and fill in values.
# Production secrets go in Vercel dashboard — never commit real values.

# =============================================================================
# Supabase
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# Stripe
# =============================================================================
# Use sk_test_* for development, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_or_sk_live_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Resend (email)
# =============================================================================
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=booking@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=your-email@example.com

# =============================================================================
# iCal feeds
# =============================================================================
ROOM1_ICAL_AIRBNB=http://localhost:3000/dev-ical/room1-airbnb.ics
ROOM1_ICAL_VRBO=http://localhost:3000/dev-ical/room1-vrbo.ics
ROOM1_ICAL_BOOKING=http://localhost:3000/dev-ical/room1-booking.ics
ROOM2_ICAL_AIRBNB=http://localhost:3000/dev-ical/room2-airbnb.ics
ROOM2_ICAL_VRBO=http://localhost:3000/dev-ical/room2-vrbo.ics
ROOM2_ICAL_BOOKING=http://localhost:3000/dev-ical/room2-booking.ics

# =============================================================================
# Sentry (error tracking — build-time, for source map upload)
# =============================================================================
SENTRY_AUTH_TOKEN=sntrys_your_sentry_auth_token

# =============================================================================
# PostHog (visitor analytics — client-side)
# =============================================================================
# Public project token and API host. This file only holds placeholders;
# real values go in .env.development locally / Vercel.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_public_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
