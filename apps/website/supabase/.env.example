# Supabase edge functions — environment template
# Copy to .env.development and fill in values.
# Production secrets: supabase secrets set KEY=value
# Local usage: supabase functions serve --env-file .env.development

# =============================================================================
# Supabase
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# AI (crm-api — POST /campaigns/suggest-template, via _shared/openrouter.ts)
# =============================================================================
OPENROUTER_API_KEY=sk-or-your_key

# =============================================================================
# crm-api — auth + CORS (apps/crm-dashboard)
# =============================================================================
# Single shared secret: login password check AND HMAC session-token signing key.
CRM_DASHBOARD_SECRET=your_crm_dashboard_secret
# Deployed crm-dashboard origin, for CORS. Defaults to http://localhost:3002
# (the dashboard's dev port) if unset — production must set this explicitly.
CRM_DASHBOARD_ORIGIN=http://localhost:3002

# =============================================================================
# crm-api — WhatsApp sending (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
CRM_TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_number
# Max messages sent per campaign per day (Meta-imposed cap for a new
# WhatsApp Business number). Defaults to 20 if unset.
CRM_DAILY_SEND_CAP=20

# =============================================================================
# prompt-eval-webhook
# =============================================================================
# Shared secret checked against LangSmith's webhook `x-webhook-secret` header.
PROMPT_EVAL_WEBHOOK_SECRET=your_prompt_eval_webhook_secret
# GitHub PAT with repository_dispatch access to trigger the eval workflow.
GITHUB_PAT=your_github_pat
GITHUB_REPO_OWNER=your_github_repo_owner
GITHUB_REPO_NAME=your_github_repo_name
