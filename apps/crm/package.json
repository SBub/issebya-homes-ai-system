{
  "name": "crm",
  "version": "0.1.0",
  "description": "CRM — owns guest_contacts (guest identity + past-stay facts). Plain logic API, no conversational/finance awareness of its own; apps/guest-communication-agent and apps/finance are its callers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build",
    "start": "next start --port 3006",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:guest-contacts": "tsx --env-file=.env scripts/sync-guest-contacts.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "next": "^16.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
