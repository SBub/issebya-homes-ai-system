# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo uses, but accessed here via Supabase's REST
# client (@supabase/supabase-js), not raw pg.Pool like every other app —
# ported as-is from apps/guest-communication-agent, this table's original
# home. `supabase status` prints the Project URL/keys to use here
# (Publishable -> SUPABASE_ANON_KEY, Secret -> SUPABASE_SERVICE_ROLE_KEY, on
# newer Supabase CLI versions).
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notion sync — pull (src/lib/notion-phone-sync.ts) and push
# (src/lib/notion-guest-contacts-sync.ts) against a dedicated "Guest Contacts"
# database, separate from apps/finance's "Finance Bookings" database (mixing
# financial records with guest contact info was tried and rejected). Reuse
# the same NOTION_API_KEY already in apps/finance/.env.
#
# GUEST_CONTACTS_NOTION_DATABASE_ID is left blank here on purpose: the real
# database already exists in the live workspace (created once via a one-off
# setup script, not something this app creates itself) — point this at your
# own database's id if replicating this setup elsewhere, don't try to
# recreate the original.
NOTION_API_KEY=
GUEST_CONTACTS_NOTION_DATABASE_ID=

# Checked via the X-API-Key header on every /api/guest-contacts/* route.
# Callers: apps/finance (POST .../sync) and apps/guest-communication-agent
# (GET .../lookup) — same value in both of their own .env files. Generate:
# openssl rand -hex 32
CRM_API_KEY=
