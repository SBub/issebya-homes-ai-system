# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo uses, but accessed here via Supabase's REST
# client (@supabase/supabase-js), not raw pg.Pool like every other app —
# ported as-is from apps/guest-communication-agent, this table's original
# home. `supabase status` prints the Project URL/keys to use here
# (Publishable -> SUPABASE_ANON_KEY, Secret -> SUPABASE_SERVICE_ROLE_KEY, on
# newer Supabase CLI versions).
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Checked via the X-API-Key header on every /api/guest-contacts/* route.
# Callers: apps/finance (POST .../sync) and apps/guest-communication-agent
# (GET .../lookup) — same value in both of their own .env files. Generate:
# openssl rand -hex 32
CRM_API_KEY=

# Where apps/telegram-router's plain logic API is reachable (no trailing
# slash). src/lib/telegram-router-client.ts's postCampaignDraft calls its
# POST /api/campaign-drafts from POST /api/cron/check-stalled-guests, once
# per drafted promo code — deliberately best-effort/fire-and-forget (see
# that file's own doc comment), so leaving these blank just means drafts
# never reach Telegram, not that the cron fails.
TELEGRAM_ROUTER_API_URL=http://localhost:3003

# Shared secret with apps/telegram-router's own TELEGRAM_ROUTER_API_KEY —
# same pattern as CRM_API_KEY above. Generate: openssl rand -hex 32
TELEGRAM_ROUTER_API_KEY=
