# From `supabase start` (local Supabase CLI dev stack) — same local instance
# apps/orch-a already uses. No production Supabase project involved.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Checked via the X-API-Key header on every /api/finance/* route and
# /api/health, and reused as the /upload page's password field (no separate
# auth system). Generate: openssl rand -hex 32
FINANCE_API_KEY=

# Notion sync (optional — import still works with these unset, sync is just
# skipped). IMPORTANT: point this at a dedicated database, never the real
# production "Finance Bookings" board. Notion integration → your test
# database's "•••" menu → Connections → share with the integration, then
# copy the database ID out of its URL.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Telegram delivery (optional — import still works with these unset,
# post-import report delivery is just skipped, same as Notion above).
# Sends a confirmation message + report attachments (invoices CSV, and
# tourist-tax CSV on quarter-closing months) after each successful import.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# guest_contacts refresh (optional — import still works with these unset,
# the sync-now request to apps/guest-communication-agent is just skipped,
# same pattern as Notion/Telegram above). Same value as GCA's own
# GUEST_COMMUNICATION_AGENT_API_KEY.
GUEST_COMMUNICATION_AGENT_API_URL=http://localhost:3005
GUEST_COMMUNICATION_AGENT_API_KEY=
