# From `supabase start` (local Supabase CLI dev stack) — same local instance
# every other app in this repo uses. No production Supabase project involved.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Checked via the X-API-Key header on every /api/finance/* route, and reused
# as the /upload page's password field (no separate auth system).
# Generate: openssl rand -hex 32
FINANCE_API_KEY=

# Telegram delivery (optional — import still works with these unset,
# post-import report delivery is just skipped). Sends a confirmation message
# + report attachments (invoices CSV, and tourist-tax CSV on quarter-closing
# months) after each successful import.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# guest_contacts refresh (optional — import still works with these unset,
# the sync-now request to apps/crm is just skipped, same pattern as
# Telegram above). Same value as CRM's own CRM_API_KEY.
CRM_API_URL=http://localhost:3006
CRM_API_KEY=
