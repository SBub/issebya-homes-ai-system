{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/telegram-router": {
      "next": true,
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "eslint-config-prettier",
        "eslint-plugin-no-secrets",
        "eslint-plugin-security"
      ]
    },
    "apps/guest-communication-agent": {
      "next": true,
      "entry": ["tests/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": [
        "eslint-config-prettier",
        "eslint-plugin-no-secrets",
        "eslint-plugin-security"
      ]
    },
    "apps/website": {
      "next": true,
      "entry": ["src/**/*.unit.test.ts", "src/**/*.browser.test.tsx", "e2e/**/*.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts"],
      "ignoreDependencies": [
        "tailwindcss",
        "eslint-config-prettier",
        "eslint-plugin-no-secrets",
        "eslint-plugin-security"
      ]
    }
  },
  "ignoreBinaries": ["stripe", "pkill", "lsof", "ngrok"],
  "ignoreFiles": [
    "apps/website/src/app/(main)/booking/[type]/page-1.tsx",
    "apps/website/src/app/(main)/booking/[type]/store-1.tsx"
  ],
  "ignoreIssues": {
    "apps/website/src/lib/ical-parser.ts": ["exports"],
    "apps/website/src/lib/shared/schemas/booking.ts": ["exports", "types"],
    "apps/website/src/lib/shared/types/booking.ts": ["types"],
    "apps/website/src/app/(main)/booking/[type]/ui/Gallery.tsx": ["types"],
    "apps/website/src/app/ui/TabsDesktop.tsx": ["types"],
    "apps/website/src/app/ui/TabsMobile.tsx": ["types"]
  }
}
